rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAccountMember(accountId) {
      return request.auth != null &&
             request.auth.token.accountId == accountId;
    }

    function isAccountAdmin(accountId) {
      return isAccountMember(accountId) &&
             request.auth.token.role in ["owner", "admin"];
    }

    match /accounts/{accountId} {
      allow read: if isAccountMember(accountId);
      allow write: if isAccountAdmin(accountId);

      match /members/{uid} {
        allow read: if isAccountMember(accountId);
        allow write: if false;
      }

      // Customers are written ONLY through the createCustomer/updateCustomer
      // callables (Admin SDK, which bypasses these Rules), so those callables are
      // the Rules-enforced single write path and the schema factories are the one
      // true validator (SECURITY: S2). Clients may read live via onSnapshot but
      // cannot write around the validator. Mirrors the jobs/members posture.
      match /customers/{customerId} {
        allow read: if isAccountMember(accountId);
        allow write: if false;
      }

      match /phoneSettings/{settingId} {
        allow read, write: if isAccountMember(accountId);
      }

      match /calls/{callId} {
        // SECURITY: server-only writes. All legitimate call writes are Admin SDK
        // (ConversationRelay service + handleCallStatus) and bypass Rules.
        // Clients read their own tenant's calls; no client writes. Mirrors the
        // customers/jobs posture. (§8 S2)
        allow read:  if isAccountMember(accountId);
        // DECISION (2026-07): calls is server-write-only. Every legitimate write is
        // Admin SDK (ConversationRelay service + handleCallStatus), which bypasses
        // Rules — so a client write path has zero legitimate use and is pure attack
        // surface. Removed it (allow write: if false). See Brief Resolved Decisions.
        allow write: if false;
      }

      match /phonePlaybook/{docId} {
        allow read: if isAccountMember(accountId);
        allow write: if false;
      }

      // Jobs are written ONLY through the createJob/updateJob callables (Admin SDK,
      // which bypasses these Rules). Clients may read the board live via onSnapshot,
      // but cannot write around the validator — the callable is the Rules-enforced
      // single write path (SECURITY: S2). Mirrors the members/phonePlaybook posture.
      match /jobs/{jobId} {
        allow read: if isAccountMember(accountId);
        allow write: if false;
      }

      // SECURITY: per-user dashboard state (lastSeenAt backing the Calls/Leads
      // "new since you last checked" badge; lastExportAt backing the "new
      // since your last download" export hint). Unlike every other
      // subcollection here, this one IS written directly by the client — there's
      // no Admin SDK path for it — so the write must be self-scoped and
      // field-restricted at the Rules layer itself (§8 S2): the doc id must be
      // the caller's own uid (never another member's), the account must match
      // their claim, and the written keys must be a subset of
      // ["lastSeenAt", "lastExportAt"] so a client can't smuggle arbitrary
      // fields onto a doc it can freely write.
      match /userState/{uid} {
        allow read: if isAccountMember(accountId) && request.auth.uid == uid;
        allow write: if isAccountMember(accountId)
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['lastSeenAt', 'lastExportAt']);
      }
    }

    match /invites/{inviteId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['email', 'accountId', 'role', 'status', 'createdAt', 'invitedBy'])
        && request.resource.data.accountId is string
        && exists(/databases/$(database)/documents/accounts/$(request.resource.data.accountId)/members/$(request.auth.uid))
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role in ['member', 'admin'];

      allow read, update, delete: if false;
    }

    // SMS consent records, captured pre-account on the public marketing site and
    // written ONLY through the submitSmsOptin function (Admin SDK bypasses these
    // Rules). This is consent PII / Twilio verification evidence — no client may
    // read or write it. Mirrors the members/customers/jobs server-only posture.
    match /smsOptins/{phoneDigits} {
      allow read, write: if false;
    }

    // Spend-guard infrastructure for the inbound voice path (§8 S4). Root-level,
    // NOT tenant-scoped: these gate a call BEFORE we know or trust the caller's
    // account, so they are not tenant-owned data (see phone-rate-limit.js
    // DECISION). Admin-SDK writes only; clients get nothing. Correctness is
    // enforced server-side — these rules exist so a leaked/forged client can
    // neither read the counters nor write them (defense-in-depth).
    match /phoneRateLimits/{bucket} {
      allow read, write: if false;
    }

    match /phoneUsage/{day} {
      allow read, write: if false;
    }
  }
}
